# Kopiere diese Datei nach ".env.local" und trage den Freigabelink ein.
#
# BELEGUNG_QUELLE: öffentlicher Nextcloud-Freigabelink der Tabelle, mit
# "/download" am Ende, z. B. https://cloud.example.de/s/AbC123xyz/download
# Die Tabelle (.xlsx oder .csv) braucht die Spalten "Anreise" und "Abreise".
BELEGUNG_QUELLE=

# Pfad, unter dem die Website die Tabelle abruft (Proxy auf BELEGUNG_QUELLE).
VITE_BELEGUNG_URL=/belegung-quelle
